# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.mobile.example in source control (it is an example, no secrets).

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Capacitor / Android ───────────────────────────────────────────────────────
# The android/ directory is COMMITTED (Capacitor platform code lives in source
# control so the team can open Android Studio without running `cap add android`).
# Only exclude generated build artifacts and secrets within it:

android/.gradle/
android/app/build/
android/build/
android/local.properties           # machine-local SDK path — never commit
android/app/release/               # signed APKs / AABs — never commit
android/**/*.keystore              # signing keystores — never commit (use secrets manager)
android/**/*.jks                   # Java keystores — never commit

# Capacitor sync output inside android (regenerated by `cap sync`)
android/app/src/main/assets/public/
# ^ This is the bundled web app. Regenerated by `npm run mobile:build`.
#   Committing it would bloat the repo; CI/CD regenerates it instead.
